### Ran Playwright code
```js
await (async page => {
  const dump = async (name) => {
    const out = await page.evaluate(() => {
      const g = window.__capy
      const vis = [...document.querySelectorAll('body *')].filter(e => { const cs = getComputedStyle(e); const r = e.getBoundingClientRect(); return cs.display !== 'none' && cs.visibility !== 'hidden' && +cs.opacity > 0.05 && r.width > 0 && e.children.length === 0 && e.textContent.trim() }).map(e => e.textContent.trim())
      const p = g.capy.body.position
      return { t: Date.now(), biome: g.biome.current, pos: [p.x, p.y, p.z].map(v => +v.toFixed(1)), vis: vis.slice(-36), err: g.state.lastError }
    })
    await page.evaluate((o) => fetch('/shot?name=' + o.name, { method: 'POST', body: btoa(unescape(encodeURIComponent(JSON.stringify(o.out)))) }), { name, out })
  }
  await page.evaluate(() => window.__capy.hud.cross('antarctic'))
  await page.waitForTimeout(4000)
  await page.screenshot({ path: 'qa/l7r-play-63.png' })
  await page.waitForTimeout(6000)
  await page.screenshot({ path: 'qa/l7r-play-64.png' })
  await dump('l7r-play-s30a.json')
  await page.keyboard.down('KeyW')
  await page.waitForTimeout(3000)
  await page.keyboard.up('KeyW')
  await page.waitForTimeout(300)
  await page.keyboard.press('Space')
  await page.waitForTimeout(400)
  await page.screenshot({ path: 'qa/l7r-play-65.png' })
  await page.waitForTimeout(1200)
  await page.keyboard.press('KeyE')
  await page.waitForTimeout(3000)
  await page.screenshot({ path: 'qa/l7r-play-66.png' })
  await dump('l7r-play-s30.json')
}
)(page);
```

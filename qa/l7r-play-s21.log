### Ran Playwright code
```js
await (async page => {
  await page.evaluate(() => { const b=[...document.querySelectorAll('button')].find(b=>/^resume$/i.test(b.textContent.trim())); if(b) b.click() })
  await page.waitForTimeout(800)
  const state = async () => page.evaluate(() => {
    const g = window.__capy
    const p = g.capy.body.position
    const cq = g.camera.quaternion
    const f = { x: -(2 * (cq.x * cq.z + cq.w * cq.y)), z: -(1 - 2 * (cq.x * cq.x + cq.y * cq.y)) }
    const n = Math.hypot(f.x, f.z) || 1
    return { pos: [p.x, p.y, p.z].map(v => +v.toFixed(2)), f: [f.x / n, f.z / n], paused: !!g.state.paused }
  })
  const target = { x: -22, z: -7 }
  const log = []
  for (let i = 0; i < 10; i++) {
    const s = await state()
    const dx = target.x - s.pos[0], dz = target.z - s.pos[2]
    const d = Math.hypot(dx, dz)
    if (d < 2.5) break
    const ux = dx / d, uz = dz / d
    const fwd = s.f
    const right = [-fwd[1], fwd[0]]
    const cands = { KeyW: fwd, KeyS: [-fwd[0], -fwd[1]], KeyD: right, KeyA: [-right[0], -right[1]] }
    let best = 'KeyW', bd = -2
    for (const k in cands) { const dot = cands[k][0] * ux + cands[k][1] * uz; if (dot > bd) { bd = dot; best = k } }
    log.push([i, s.pos, +d.toFixed(1), best, s.paused])
    await page.keyboard.down(best); await page.waitForTimeout(best === 'KeyW' ? 1500 : 900); await page.keyboard.up(best)
    await page.waitForTimeout(150)
  }
  await page.screenshot({ path: 'qa/l7r-play-37.png' })
  await page.keyboard.press('KeyQ'); await page.waitForTimeout(1200)
  await page.keyboard.press('KeyQ'); await page.waitForTimeout(1200)
  await page.keyboard.press('KeyQ'); await page.waitForTimeout(2500)
  await page.screenshot({ path: 'qa/l7r-play-38.png' })
  await page.waitForTimeout(6000)
  await page.screenshot({ path: 'qa/l7r-play-39.png' })
  const out = await page.evaluate(() => {
    const g = window.__capy
    const vis = [...document.querySelectorAll('body *')].filter(e => { const cs = getComputedStyle(e); const r = e.getBoundingClientRect(); return cs.display !== 'none' && cs.visibility !== 'hidden' && +cs.opacity > 0.05 && r.width > 0 && e.children.length === 0 && e.textContent.trim() }).map(e => e.textContent.trim())
    const p = g.capy.body.position
    return { biome: g.biome.current, pos: [p.x, p.y, p.z].map(v => +v.toFixed(1)), vis: vis.slice(-40), err: g.state.lastError }
  })
  await page.evaluate((o) => fetch('/shot?name=l7r-play-s21.json', { method: 'POST', body: btoa(unescape(encodeURIComponent(JSON.stringify(o)))) }), { log, out })
}
)(page);
